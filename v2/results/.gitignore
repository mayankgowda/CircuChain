# Generated outputs are not committed, except manifests + the regrade summary (the citable artifact).
*
!.gitignore
!regrade_v1/
!regrade_v1/**
!manifests/
!manifests/**
!pilot/
pilot/*
!pilot/reports/
!pilot/reports/**
!tables/
!tables/**
!figures/
!figures/**
!contour/
contour/*
!contour/tables/
!contour/tables/**
!contour_hard/
contour_hard/*
!contour_hard/tables/
!contour_hard/tables/**
!rhr/
rhr/*
!rhr/tables/
!rhr/tables/**
!rhr_xhard/
rhr_xhard/*
!rhr_xhard/tables/
!rhr_xhard/tables/**
